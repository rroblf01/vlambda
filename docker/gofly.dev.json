{
  "port": 8080,
  "workers": 1,
  "access_log": true,
  "max_body_size": 4194304,
  "rate_limit": {
    "requests_per_second": 50,
    "burst": 100,
    "idle_ttl": "10m"
  },
  "routes": [
    {
      "path": "/",
      "upstreams": ["http://127.0.0.1:8081"],
      "health_check_path": "/health",
      "health_check_interval": "10s",
      "upstream_timeout": "10s",
      "set_headers": {
        "X-Real-IP": "$remote_addr",
        "X-Forwarded-For": "$remote_addr"
      }
    }
  ],
  "tls": { "enabled": false }
}
